# Copiar a .env.local para desarrollo. En Vercel, cargar en Environment Variables.
# El dominio definitivo de Vercel se configura antes de la compilación de producción.
PUBLIC_SITE_ORIGIN=http://localhost:5173

# Origen ya autorizado por la API local. Mantenerlo igual a APP_ORIGIN efectivo
# del backend; el gateway comprueba por separado el origen real del navegador.
EXPRESS_ALLOWED_ORIGIN=https://api.neadev.com

# Solo exposición con frontend y API en la misma PC. Dejar vacío en Vercel.
# El destino local admite únicamente http://127.0.0.1 con puerto explícito.
EXPRESS_LOCAL_API_ORIGIN=

# Opcional: completar AMBOS cuando Cloudflare Access use Service Auth.
# Solo servidor. Nunca usar NEXT_PUBLIC_ ni guardar secretos en Git.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Solo para verificaciones HTTP optativas; no interviene en el cliente.
# TEST_SITE_ORIGIN=https://tu-proyecto.vercel.app
